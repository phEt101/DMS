      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.3.1/css/all.min.css');\n*{box-sizing:border-box}\nbody{margin:0;font-family:'IBM Plex Sans Thai',sans-serif;color:#1c2540;font-size:14px;background:#101629}\n.backdrop{min-height:1010px;padding:40px 20px;background:rgba(16,22,41,.5);display:flex;justify-content:center;align-items:flex-start}\n.modal{width:680px;background:#fff;border-radius:22px;overflow:hidden;box-shadow:0 24px 70px rgba(16,22,41,.35);display:flex;flex-direction:column}\n.m-head{display:flex;justify-content:space-between;gap:14px;padding:20px 24px 16px;border-bottom:1px solid #e9eef5}\n.docline{display:flex;align-items:center;gap:8px;font-size:12px}\n.docline .no{font-weight:700;color:#5143e8;letter-spacing:.02em}\n.docline .sep{width:3px;height:3px;border-radius:50%;background:#c3cad8}\n.docline .when{color:#7a849e}\n.m-head h2{margin:6px 0 0;font-size:21px;font-weight:800;letter-spacing:-.2px}\n.statusline{display:flex;align-items:center;gap:8px;margin-top:9px;flex-wrap:wrap}\n.statusline .meta{font-size:11.5px;color:#7a849e}\n.chip{display:inline-flex;align-items:center;gap:5px;height:24px;padding:0 9px;border-radius:999px;font-size:11.5px;font-weight:700;white-space:nowrap}\n.chip.rejected{background:#fee2e2;color:#b91c1c}\n.close{flex:none;width:36px;height:36px;border-radius:11px;border:1px solid #e3e8f2;background:#fff;color:#59657a;font-size:17px;line-height:1;display:grid;place-items:center}\n.m-body{padding:20px 24px 24px;display:flex;flex-direction:column;gap:22px}\n.feedback{background:#fff7f7;border:1px solid #fadadd;border-radius:14px;padding:14px 16px}\n.fb-head{display:flex;align-items:center;gap:8px;margin-bottom:8px}\n.fb-head i{color:#c0392b;font-size:13px}\n.fb-head h3{margin:0;font-size:13px;font-weight:800;color:#9e3b3b}\n.fb-head .when{margin-left:auto;font-size:11px;color:#a86868}\n.fb-reason{margin:0;font-size:13px;line-height:1.6;color:#7d2f2f}\n.fb-meta{display:flex;align-items:center;gap:7px;margin-top:10px;font-size:11.5px;color:#9a6565}\n.fb-meta img{width:22px;height:22px;border-radius:50%;object-fit:cover}\n.fb-meta b{font-weight:700;color:#7d2f2f}\n.section-title{display:flex;align-items:center;gap:8px;margin:0 0 10px;font-size:13.5px;font-weight:800;color:#172033}\n.count-pill{font-size:11px;font-weight:700;color:#5b647a;background:#f2f5f9;border-radius:999px;padding:2px 8px}\n.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 28px;margin:0}\n.detail-grid > div{padding:9px 0;border-bottom:1px solid #f0f3f8}\n.detail-grid > div.full{grid-column:1/-1}\n.detail-grid dt{margin:0 0 2px;font-size:11px;color:#7a849e}\n.detail-grid dd{margin:0;font-size:13px;color:#283451;font-weight:600}\n.route{list-style:none;margin:0;padding:0}\n.route li{position:relative;padding:0 0 16px 36px;min-height:32px}\n.route li:last-child{padding-bottom:0}\n.route li::before{content:'';position:absolute;left:11px;top:23px;bottom:0;width:1px;background:#e5e9f0}\n.route li:last-child::before{display:none}\n.node{position:absolute;left:0;top:0;width:23px;height:23px;border-radius:50%;display:grid;place-items:center;font-size:10px;font-weight:800;background:#eef1f6;color:#7a849e}\n.route li.done .node{background:#dcfce7;color:#15803d}\n.route li.rejected .node{background:#fee2e2;color:#b91c1c}\n.route b{display:block;font-size:12.5px}\n.route small{display:block;margin-top:1px;font-size:11.5px;color:#7a849e}\n.history{list-style:none;margin:0;padding:0}\n.history li{display:grid;grid-template-columns:112px minmax(0,1fr);gap:12px;padding:0 0 14px}\n.history li:last-child{padding-bottom:0}\n.h-date{font-size:11px;color:#7a849e;padding-top:2px;line-height:1.4}\n.h-body b{display:block;font-size:12.5px;font-weight:700}\n.h-body small{display:block;margin-top:1px;font-size:11.5px;color:#7a849e}\n.h-reason{margin:7px 0 0;padding:8px 10px;border-radius:9px;background:#fff7f7;color:#9e3b3b;font-size:11.5px;line-height:1.5}\n.h-reason b{display:inline;font-size:11.5px;font-weight:700;color:#b42357}\n.m-foot{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 24px;border-top:1px solid #e9eef5;background:#fbfcfe}\n.foot-note{max-width:320px;font-size:11px;line-height:1.45;color:#7a849e}\n.foot-actions{display:flex;gap:8px}\n.btn{display:inline-flex;align-items:center;gap:8px;height:42px;padding:0 16px;border-radius:12px;font:inherit;font-size:13px;font-weight:700;white-space:nowrap}\n.btn.ghost{background:#fff;border:1px solid #e3e8f2;color:#465268}\n.btn.primary{background:#5143e8;border:0;color:#fff;box-shadow:0 10px 22px -12px rgba(81,67,232,.8)}\n.btn i{font-size:12px}\n</style>\n<div class=\"backdrop\" data-kid=\"1\" data-name=\"modal backdrop overlay\">\n<section aria-labelledby=\"doc-title\" aria-modal=\"true\" class=\"modal\" data-kid=\"1-1\" data-name=\"rejected leave request dialog modal\" role=\"dialog\">\n<header class=\"m-head\" data-kid=\"1-1-1\" data-name=\"modal header bar\">\n<div data-kid=\"1-1-1-1\" data-name=\"modal header info container\">\n<div class=\"docline\" data-kid=\"1-1-1-1-1\" data-name=\"document reference line\"><span class=\"no\" data-kid=\"1-1-1-1-1-1\" data-name=\"document reference number\">LV-2026-0013</span><span class=\"sep\" data-kid=\"1-1-1-1-1-2\" data-name=\"reference line dot separator\"></span><span class=\"when\" data-kid=\"1-1-1-1-1-3\" data-name=\"submission date and time text\">ยื่นเมื่อ 9 พ.ย. 69 10:42</span></div>\n<h2 data-kid=\"1-1-1-1-2\" data-name=\"leave request headline\" id=\"doc-title\">ลากิจ · 1 วัน</h2>\n<div class=\"statusline\" data-kid=\"1-1-1-1-3\" data-name=\"approval status row\">\n<span class=\"chip rejected\" data-kid=\"1-1-1-1-3-1\" data-name=\"rejected status chip\">ไม่อนุมัติ</span>\n<span class=\"meta\" data-kid=\"1-1-1-1-3-2\" data-name=\"reviewer and decision meta info\">โดย วีระ ศรีสุข · ผู้จัดการแผนก · 11 พ.ย. 69</span>\n</div>\n</div>\n<button aria-label=\"ปิด\" class=\"close\" data-kid=\"1-1-1-2\" data-name=\"modal close button\">×</button>\n</header>\n<div class=\"m-body\" data-kid=\"1-1-2\" data-name=\"modal body content\">\n<section class=\"feedback\" data-kid=\"1-1-2-1\" data-name=\"rejection feedback panel\">\n<div class=\"fb-head\" data-kid=\"1-1-2-1-1\" data-name=\"feedback panel header row\">\n<i class=\"fa-solid fa-circle-exclamation\" data-kid=\"1-1-2-1-1-1\" data-name=\"warning exclamation icon\"></i>\n<h3 data-kid=\"1-1-2-1-1-2\" data-name=\"rejection reason panel title\">เหตุผลที่ไม่อนุมัติ</h3>\n<span class=\"when\" data-kid=\"1-1-2-1-1-3\" data-name=\"rejection decision timestamp\">11 พ.ย. 69 14:20</span>\n</div>\n<p class=\"fb-reason\" data-kid=\"1-1-2-1-2\" data-name=\"rejection reason body text\">วันที่ 18 พ.ย. มีประชุมปิดงบการตลาด ขอให้เลื่อนวันลาเป็นสัปดาห์ถัดไป และแจ้งหัวหน้างานอีกครั้งหลังปรับวันแล้ว</p>\n<div class=\"fb-meta\" data-kid=\"1-1-2-1-3\" data-name=\"reviewer attribution row\">\n<img alt=\"วีระ ศรีสุข\" data-kid=\"1-1-2-1-3-1\" data-name=\"reviewer avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/44?u=weera-srisuk\"/>\n<span data-kid=\"1-1-2-1-3-2\" data-name=\"reviewer name and title span\"><b data-kid=\"1-1-2-1-3-2-1\" data-name=\"reviewer name text\">วีระ ศรีสุข</b> · ผู้จัดการแผนกการตลาด</span>\n</div>\n</section>\n<section data-kid=\"1-1-2-2\" data-name=\"leave request details section\">\n<h3 class=\"section-title\" data-kid=\"1-1-2-2-1\" data-name=\"details section title\">รายละเอียดคำขอ</h3>\n<dl class=\"detail-grid\" data-kid=\"1-1-2-2-2\" data-name=\"leave details definition grid\">\n<div data-kid=\"1-1-2-2-2-1\" data-name=\"leave type detail row\"><dt data-kid=\"1-1-2-2-2-1-1\" data-name=\"leave type label\">ประเภทการลา</dt><dd data-kid=\"1-1-2-2-2-1-2\" data-name=\"leave type value\">ลากิจ</dd></div>\n<div data-kid=\"1-1-2-2-2-2\" data-name=\"duration detail row\"><dt data-kid=\"1-1-2-2-2-2-1\" data-name=\"duration label\">จำนวนวัน</dt><dd data-kid=\"1-1-2-2-2-2-2\" data-name=\"duration value text\">1 วัน (8 ชั่วโมง)</dd></div>\n<div data-kid=\"1-1-2-2-2-3\" data-name=\"start date detail row\"><dt data-kid=\"1-1-2-2-2-3-1\" data-name=\"start date label\">วันที่เริ่ม</dt><dd data-kid=\"1-1-2-2-2-3-2\" data-name=\"start date value\">18 พ.ย. 69</dd></div>\n<div data-kid=\"1-1-2-2-2-4\" data-name=\"end date detail row\"><dt data-kid=\"1-1-2-2-2-4-1\" data-name=\"end date label\">วันที่สิ้นสุด</dt><dd data-kid=\"1-1-2-2-2-4-2\" data-name=\"end date value\">18 พ.ย. 69</dd></div>\n<div class=\"full\" data-kid=\"1-1-2-2-2-5\" data-name=\"leave reason detail row\"><dt data-kid=\"1-1-2-2-2-5-1\" data-name=\"leave reason label\">เหตุผลการลา</dt><dd data-kid=\"1-1-2-2-2-5-2\" data-name=\"leave reason value\">ธุระที่ธนาคาร</dd></div>\n</dl>\n</section>\n<section data-kid=\"1-1-2-3\" data-name=\"approval workflow section\">\n<h3 class=\"section-title\" data-kid=\"1-1-2-3-1\" data-name=\"workflow section title\">ขั้นตอนการพิจารณา</h3>\n<ol class=\"route\" data-kid=\"1-1-2-3-2\" data-name=\"approval route timeline\">\n<li class=\"done\" data-kid=\"1-1-2-3-2-1\" data-name=\"completed submission timeline step\">\n<span class=\"node\" data-kid=\"1-1-2-3-2-1-1\" data-name=\"completed step status node\"><i class=\"fa-solid fa-check\" data-kid=\"1-1-2-3-2-1-1-1\" data-name=\"checkmark icon\"></i></span>\n<div data-kid=\"1-1-2-3-2-1-2\" data-name=\"submission step details\"><b data-kid=\"1-1-2-3-2-1-2-1\" data-name=\"submitter role label\">ผู้ยื่น</b><small data-kid=\"1-1-2-3-2-1-2-2\" data-name=\"submitter name and date\">สมชาย ใจดี · ยื่นเมื่อ 9 พ.ย. 69 10:42</small></div>\n</li>\n<li class=\"rejected\" data-kid=\"1-1-2-3-2-2\" data-name=\"rejected step timeline step\">\n<span class=\"node\" data-kid=\"1-1-2-3-2-2-1\" data-name=\"rejected step status node\">!</span>\n<div data-kid=\"1-1-2-3-2-2-2\" data-name=\"rejection step details\"><b data-kid=\"1-1-2-3-2-2-2-1\" data-name=\"manager role label\">ผู้จัดการแผนก</b><small data-kid=\"1-1-2-3-2-2-2-2\" data-name=\"manager rejection date and note\">วีระ ศรีสุข · ไม่อนุมัติ 11 พ.ย. 69 14:20</small></div>\n</li>\n<li data-kid=\"1-1-2-3-2-3\" data-name=\"pending HR timeline step\">\n<span class=\"node\" data-kid=\"1-1-2-3-2-3-1\" data-name=\"pending step status node\"></span>\n<div data-kid=\"1-1-2-3-2-3-2\" data-name=\"HR step details\"><b data-kid=\"1-1-2-3-2-3-2-1\" data-name=\"HR role label\">HR</b><small data-kid=\"1-1-2-3-2-3-2-2\" data-name=\"HR pending status text\">รอดำเนินการ</small></div>\n</li>\n</ol>\n</section>\n<section data-kid=\"1-1-2-4\" data-name=\"review history section\">\n<h3 class=\"section-title\" data-kid=\"1-1-2-4-1\" data-name=\"history section title\">ประวัติการพิจารณา <span class=\"count-pill\" data-kid=\"1-1-2-4-1-1\" data-name=\"history count badge\">1 ครั้ง</span></h3>\n<ol class=\"history\" data-kid=\"1-1-2-4-2\" data-name=\"review history list\">\n<li data-kid=\"1-1-2-4-2-1\" data-name=\"submission history entry\">\n<span class=\"h-date\" data-kid=\"1-1-2-4-2-1-1\" data-name=\"submission entry date\">9 พ.ย. 69<br data-kid=\"1-1-2-4-2-1-1-1\" data-name=\"date and time line break\"/>10:42</span>\n<div class=\"h-body\" data-kid=\"1-1-2-4-2-1-2\" data-name=\"submission entry body\"><b data-kid=\"1-1-2-4-2-1-2-1\" data-name=\"submission entry action title\">ยื่นเอกสาร</b><small data-kid=\"1-1-2-4-2-1-2-2\">สมชาย ใจดี · ผู้ยื่น</small></div>\n</li>\n<li data-kid=\"1-1-2-4-2-2\">\n<span class=\"h-date\" data-kid=\"1-1-2-4-2-2-1\">11 พ.ย. 69<br data-kid=\"1-1-2-4-2-2-1-1\"/>14:20</span>\n<div class=\"h-body\" data-kid=\"1-1-2-4-2-2-2\">\n<b data-kid=\"1-1-2-4-2-2-2-1\">ไม่อนุมัติ · ผู้จัดการแผนก</b>\n<small data-kid=\"1-1-2-4-2-2-2-2\">วีระ ศรีสุข</small>\n<p class=\"h-reason\" data-kid=\"1-1-2-4-2-2-2-3\"><b data-kid=\"1-1-2-4-2-2-2-3-1\">เหตุผล:</b> วันที่ 18 พ.ย. มีประชุมปิดงบการตลาด ขอให้เลื่อนวันลาเป็นสัปดาห์ถัดไป และแจ้งหัวหน้างานอีกครั้งหลังปรับวันแล้ว</p>\n</div>\n</li>\n</ol>\n</section>\n</div>\n<footer class=\"m-foot\" data-kid=\"1-1-3\">\n<span class=\"foot-note\" data-kid=\"1-1-3-1\">เลขที่เอกสาร LV-2026-0013 และประวัติการพิจารณาเดิมจะไม่เปลี่ยน</span>\n<div class=\"foot-actions\" data-kid=\"1-1-3-2\">\n<button class=\"btn ghost\" data-kid=\"1-1-3-2-1\">ปิด</button>\n<button class=\"btn primary\" data-kid=\"1-1-3-2-2\"><i class=\"fa-solid fa-pen-nib\" data-kid=\"1-1-3-2-2-1\"></i> แก้ไขและยื่นใหม่</button>\n</div>\n</footer>\n</section>\n</div>",
