      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.3.1/css/all.min.css');\n*{box-sizing:border-box}\nbody{margin:0;font-family:'IBM Plex Sans Thai',sans-serif;background:#f2f5f9;color:#1c2540;font-size:14px}\n.app{display:flex;min-height:1024px}\n.sidebar{width:252px;flex:0 0 252px;background:#fff;border-right:1px solid #dfe4ed;display:flex;flex-direction:column;box-shadow:6px 0 24px rgba(25,34,58,.045)}\n.brand{height:72px;display:flex;align-items:center;gap:11px;padding:0 18px;border-bottom:1px solid #dfe4ed}\n.mark{position:relative;width:32px;height:32px;flex:0 0 32px;border-radius:10px;background:linear-gradient(145deg,#7564f2,#5442d8);box-shadow:0 5px 12px rgba(101,87,232,.28)}\n.mark span{position:absolute;top:50%;left:50%;width:4px;border-radius:4px;background:#fff;transform:translate(-50%,-50%)}\n.mark .b1{height:12px;margin-left:-6px}\n.mark .b2{height:17px}\n.mark .b3{height:9px;margin-left:6px}\n.brand strong{display:block;font-size:15px;line-height:1.15}\n.brand small{display:block;font-size:11px;color:#59657a;margin-top:2px}\n.nav{padding:16px 12px;display:flex;flex-direction:column;gap:2px}\n.nav-item{height:44px;display:flex;align-items:center;gap:11px;padding:0 12px;border-radius:9px;color:#465268;font-size:14px;font-weight:500;text-decoration:none;white-space:nowrap}\n.nav-item i.lead{width:17px;text-align:center;font-size:15px;flex:none}\n.nav-item .caret{margin-left:auto;font-size:9px;color:#a1a9b9}\n.nav-item.active{background:#e9e6ff;color:#4736d1;font-weight:700;position:relative}\n.nav-item.active::before{content:'';position:absolute;left:-12px;top:12px;width:3px;height:20px;border-radius:0 4px 4px 0;background:#5847df}\n.nav-badge{margin-left:auto;min-width:22px;padding:2px 7px;border-radius:999px;background:#fff;color:#6a5de2;font-size:11px;font-weight:700;text-align:center}\n.subnav{margin:3px 0 6px 18px;padding-left:8px;border-left:1px solid #ddd9ff;display:flex;flex-direction:column;gap:2px}\n.subnav a{height:38px;display:flex;align-items:center;padding:0 12px;border-radius:9px;font-size:13px;color:#465268;text-decoration:none;white-space:nowrap}\n.subnav a.active{background:#eeeaff;color:#4736d1;font-weight:700}\n.subnav .count{margin-left:auto;font-size:11px;color:#7a849e;background:#f2f5f9;border-radius:999px;padding:1px 7px}\n.subnav a.active .count{background:#fff;color:#5b4fe0}\n.dot-badge{width:6px;height:6px;border-radius:50%;background:#e5484d;margin-left:auto}\n.nav-spacer{flex:1}\n.side-foot{padding:12px;border-top:1px solid #eef2f7}\n.main{flex:1;min-width:0}\n.topbar{height:72px;background:#fff;border-bottom:1px solid #dfe4ed;display:flex;align-items:center;justify-content:space-between;padding:0 30px}\n.crumbs{display:flex;align-items:center;gap:9px;font-size:13px;color:#7a849e}\n.crumbs b{color:#1c2540;font-weight:700}\n.crumbs i{font-size:9px}\n.top-actions{display:flex;align-items:center;gap:15px}\n.icon-btn{position:relative;width:40px;height:40px;border-radius:12px;border:1px solid #e3e8f2;background:#fff;color:#59657a;font-size:15px;display:grid;place-items:center}\n.ping{position:absolute;top:8px;right:9px;width:7px;height:7px;border-radius:50%;background:#e5484d;border:2px solid #fff}\n.lang{font-size:12px;font-weight:700;color:#59657a;border:1px solid #e3e8f2;border-radius:8px;padding:5px 9px;background:#fff}\n.me{display:flex;align-items:center;gap:9px}\n.me img{width:36px;height:36px;border-radius:50%;object-fit:cover}\n.me strong{display:block;font-size:13px;line-height:1.2}\n.me small{display:block;font-size:11px;color:#7a849e;margin-top:2px}\n.page{padding:26px 30px 34px;max-width:1200px}\n.page-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:18px}\n.page-head h1{margin:0 0 4px;font-size:32px;font-weight:800;letter-spacing:-.3px}\n.page-head p{margin:0;color:#6a7592;font-size:13px}\n.primary{display:inline-flex;align-items:center;gap:8px;height:46px;padding:0 18px;border:0;border-radius:14px;background:#5143e8;color:#fff;font:inherit;font-size:14px;font-weight:700;box-shadow:0 10px 22px -12px rgba(81,67,232,.8);white-space:nowrap}\n.toolbar{display:flex;align-items:center;gap:10px;margin-bottom:14px}\n.search{flex:1;display:flex;align-items:center;gap:10px;height:46px;padding:0 14px;border:1px solid #e3e8f2;border-radius:14px;background:#fff;color:#75809b}\n.search input{border:0;outline:0;background:transparent;font:inherit;font-size:13px;width:100%;color:#1c2540}\n.search input::placeholder{color:#8a94aa}\n.tool-group{display:flex;align-items:center;gap:8px}\n.toggle{display:flex;gap:3px;padding:4px;border:1px solid #e3e8f2;border-radius:13px;background:#f7f9fc}\n.toggle button{width:36px;height:34px;border:0;border-radius:9px;background:transparent;color:#6a7592;font-size:14px;display:grid;place-items:center}\n.toggle button.on{background:#fff;color:#5143e8;box-shadow:0 2px 7px rgba(32,41,75,.1)}\n.filter-btn{display:inline-flex;align-items:center;gap:7px;height:43px;padding:0 13px;border:1px solid #e3e8f2;border-radius:13px;background:#fff;color:#35405d;font:inherit;font-size:13px;font-weight:700;white-space:nowrap}\n.stat{display:inline-flex;align-items:center;gap:7px;height:43px;padding:0 13px;border:1px solid #e3e8f2;border-radius:13px;background:#f7f9fc;font-size:13px;font-weight:700;color:#35405d;white-space:nowrap}\n.stat i{color:#5143e8}\n.tabs{display:flex;align-items:center;gap:6px;margin:0 0 14px;flex-wrap:wrap}\n.tab{height:36px;display:inline-flex;align-items:center;gap:7px;padding:0 13px;border-radius:10px;border:1px solid transparent;background:transparent;color:#5b647a;font:inherit;font-size:13px;font-weight:600}\n.tab b{font-weight:700;color:#8a94aa;font-size:12px}\n.tab.on{border-color:#cdc7ff;background:#f2f0ff;color:#4338ca}\n.tab.on b{color:#5b4fe0}\n.table{background:#fff;border:1px solid #e5e9f0;border-radius:16px;overflow:hidden;box-shadow:0 2px 8px rgba(35,48,77,.03)}\n.tr{display:grid;grid-template-columns:228px minmax(0,1fr) 172px 184px 194px;padding:0 18px}\n.thead{background:#f8fafc;border-bottom:1px solid #e9eef5;color:#75809b;font-size:11.5px;font-weight:700}\n.thead .tr{padding-top:12px;padding-bottom:12px;align-items:center}\n.row{display:grid;grid-template-columns:228px minmax(0,1fr) 172px 184px 194px;padding:15px 18px;border-bottom:1px solid #eef2f7;cursor:pointer;align-items:start}\n.row:last-child{border-bottom:0}\n.row.revised{background:#fbfaff}\n.row > div{padding-right:16px;min-width:0}\n.row > div:last-child{padding-right:0}\n.ident{display:flex;gap:10px}\n.kind-icon{width:34px;height:34px;flex:0 0 34px;border-radius:10px;display:grid;place-items:center;background:#eef2ff;color:#5e4bff;font-size:14px}\n.kind-icon.ot{background:#fff4e5;color:#b45309}\n.kind-icon.time{background:#e8f7f4;color:#0f766e}\n.ident strong{display:block;font-size:13px;font-weight:700}\n.ident small{display:block;font-size:11.5px;color:#7a849e;margin-top:2px}\n.rev{display:inline-flex;align-items:center;gap:5px;margin-top:5px;height:20px;padding:0 7px;border:1px solid #e0dcfb;border-radius:6px;background:#f6f4ff;color:#5b4fe0;font-size:10.5px;font-weight:700;white-space:nowrap}\n.rev i{font-size:9px}\n.leave-dates{display:block;font-size:13px;font-weight:700;color:#283451}\n.reason{margin:2px 0 0;font-size:12px;color:#6a7592;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.reject-preview{margin:6px 0 0;font-size:11.5px;color:#9e3b3b;line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n.reject-preview b{font-weight:700;color:#b42357}\n.submitter{display:flex;gap:9px;align-items:center}\n.submitter img{width:30px;height:30px;border-radius:50%;object-fit:cover}\n.submitter strong{display:block;font-size:12.5px;font-weight:600}\n.submitter small{display:block;font-size:11px;color:#7a849e;margin-top:1px}\n.status-cell .stage{display:block;margin-top:5px;font-size:11px;color:#7a849e;line-height:1.4}\n.chip{display:inline-flex;align-items:center;gap:5px;height:24px;padding:0 9px;border-radius:999px;font-size:11.5px;font-weight:700;white-space:nowrap}\n.chip i{font-size:9.5px}\n.chip.pending{background:#dbeafe;color:#1d4ed8}\n.chip.revised{background:#ece9ff;color:#4c3fd6}\n.chip.rejected{background:#fee2e2;color:#b91c1c}\n.chip.approved{background:#dcfce7;color:#15803d}\n.hist strong{display:block;font-size:12px;color:#283451;font-weight:700}\n.hist span{display:block;margin-top:3px;font-size:11px;color:#7a849e;line-height:1.4}\n.hist .none{color:#a1a9b9;margin-top:2px}\n.inline-action{display:inline-flex;align-items:center;gap:6px;margin-top:7px;height:28px;padding:0 10px;border:1px solid #dedcfb;border-radius:8px;background:#f5f4ff;color:#5143e8;font:inherit;font-size:11px;font-weight:700;white-space:nowrap}\n.pager{display:flex;justify-content:space-between;align-items:center;margin-top:14px;color:#6a7592;font-size:12.5px}\n.pager .pages{display:flex;gap:6px;align-items:center}\n.pg{height:32px;min-width:32px;padding:0 10px;border:1px solid #e3e8f2;border-radius:9px;background:#fff;color:#5b647a;font:inherit;font-size:12px;display:grid;place-items:center}\n.pg.on{background:#f2f0ff;border-color:#cdc7ff;color:#4338ca;font-weight:700}\n.pg.size{color:#7a849e}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"app layout container with sidebar and main\">\n<aside class=\"sidebar\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n<div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand header with logo\">\n<span class=\"mark\" data-kid=\"1-1-1-1\" data-name=\"bar-chart logo mark\"><span class=\"b1\" data-kid=\"1-1-1-1-1\" data-name=\"logo bar 1\"></span><span class=\"b2\" data-kid=\"1-1-1-1-2\" data-name=\"logo bar 2\"></span><span class=\"b3\" data-kid=\"1-1-1-1-3\" data-name=\"logo bar 3\"></span></span>\n<div data-kid=\"1-1-1-2\" data-name=\"brand text block\"><strong data-kid=\"1-1-1-2-1\" data-name=\"brand name text\">Boswell</strong><small data-kid=\"1-1-1-2-2\" data-name=\"brand tagline text\">ระบบจัดการเอกสาร</small></div>\n</div>\n<nav class=\"nav\" data-kid=\"1-1-2\" data-name=\"main sidebar navigation\">\n<a class=\"nav-item\" data-kid=\"1-1-2-1\" data-name=\"dashboard nav item\"><i class=\"fa-solid fa-table-cells-large lead\" data-kid=\"1-1-2-1-1\" data-name=\"grid cells icon\"></i> แดชบอร์ด</a>\n<a class=\"nav-item\" data-kid=\"1-1-2-2\" data-name=\"projects nav item\"><i class=\"fa-regular fa-file-lines lead\" data-kid=\"1-1-2-2-1\" data-name=\"document icon\"></i> โครงการ <i class=\"fa-solid fa-chevron-down caret\" data-kid=\"1-1-2-2-2\" data-name=\"dropdown caret icon\"></i></a>\n<div data-kid=\"1-1-2-3\" data-name=\"documents nav group\">\n<a class=\"nav-item active\" data-kid=\"1-1-2-3-1\" data-name=\"documents nav item (active)\"><i class=\"fa-regular fa-folder-open lead\" data-kid=\"1-1-2-3-1-1\" data-name=\"open folder icon\"></i> เอกสาร <span class=\"nav-badge\" data-kid=\"1-1-2-3-1-2\" data-name=\"documents count badge\">3</span> <i class=\"fa-solid fa-chevron-up caret\" data-kid=\"1-1-2-3-1-3\" data-name=\"expanded caret icon\"></i></a>\n<div class=\"subnav\" data-kid=\"1-1-2-3-2\" data-name=\"documents sub-navigation\">\n<a class=\"active\" data-kid=\"1-1-2-3-2-1\" data-name=\"all documents sub-nav link (active)\">เอกสารทั้งหมด <span class=\"count\" data-kid=\"1-1-2-3-2-1-1\" data-name=\"count badge 6\">6</span></a>\n<a data-kid=\"1-1-2-3-2-2\" data-name=\"awaiting review sub-nav link\">รอพิจารณา <span class=\"count\" data-kid=\"1-1-2-3-2-2-1\" data-name=\"count badge 2\">2</span></a>\n<a data-kid=\"1-1-2-3-2-3\" data-name=\"leave ledger sub-nav link\">สมุดบันทึกการลา</a>\n<a data-kid=\"1-1-2-3-2-4\" data-name=\"reports sub-nav link\">รายงาน</a>\n<a data-kid=\"1-1-2-3-2-5\" data-name=\"employees sub-nav link\">พนักงาน</a>\n<a data-kid=\"1-1-2-3-2-6\" data-name=\"leave policy sub-nav link\">นโยบายการลา<