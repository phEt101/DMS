      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Caveat:wght@600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.3.1/css/all.min.css');\n*{box-sizing:border-box}\nbody{margin:0;font-family:'IBM Plex Sans Thai',sans-serif;color:#1c2540;font-size:14px;background:#101629}\n.backdrop{min-height:1060px;padding:40px 20px;background:rgba(16,22,41,.5);display:flex;justify-content:center;align-items:flex-start}\n.modal{width:680px;background:#fff;border-radius:22px;overflow:hidden;box-shadow:0 24px 70px rgba(16,22,41,.35);display:flex;flex-direction:column}\n.m-head{display:flex;justify-content:space-between;gap:14px;padding:20px 24px 16px;border-bottom:1px solid #e9eef5}\n.docline{display:flex;align-items:center;gap:8px;font-size:12px}\n.docline .no{font-weight:700;color:#5143e8;letter-spacing:.02em}\n.docline .sep{width:3px;height:3px;border-radius:50%;background:#c3cad8}\n.docline .when{color:#7a849e}\n.m-head h2{margin:6px 0 0;font-size:21px;font-weight:800;letter-spacing:-.2px}\n.statusline{display:flex;align-items:center;gap:8px;margin-top:9px;flex-wrap:wrap}\n.statusline .meta{font-size:11.5px;color:#7a849e}\n.chip{display:inline-flex;align-items:center;gap:5px;height:24px;padding:0 9px;border-radius:999px;font-size:11.5px;font-weight:700;white-space:nowrap}\n.chip.rejected{background:#fee2e2;color:#b91c1c}\n.close{flex:none;width:36px;height:36px;border-radius:11px;border:1px solid #e3e8f2;background:#fff;color:#59657a;font-size:17px;line-height:1;display:grid;place-items:center}\n.m-body{padding:20px 24px 24px;display:flex;flex-direction:column;gap:22px}\n.feedback{background:#fff7f7;border:1px solid #fadadd;border-radius:14px;padding:14px 16px}\n.fb-head{display:flex;align-items:center;gap:8px;margin-bottom:8px}\n.fb-head i{color:#c0392b;font-size:13px}\n.fb-head h3{margin:0;font-size:13px;font-weight:800;color:#9e3b3b}\n.fb-head .when{margin-left:auto;font-size:11px;color:#a86868}\n.fb-reason{margin:0;font-size:13px;line-height:1.6;color:#7d2f2f}\n.fb-meta{display:flex;align-items:center;gap:7px;margin-top:10px;font-size:11.5px;color:#9a6565}\n.fb-meta img{width:22px;height:22px;border-radius:50%;object-fit:cover}\n.fb-meta b{font-weight:700;color:#7d2f2f}\n.section-title{display:flex;align-items:center;gap:8px;margin:0 0 10px;font-size:13.5px;font-weight:800;color:#172033}\n.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px 16px}\n.field{display:flex;flex-direction:column;gap:6px;min-width:0}\n.field.full{grid-column:1/-1}\n.field > span{font-size:11.5px;font-weight:700;color:#475569}\n.control{display:flex;align-items:center;gap:8px;height:44px;padding:0 12px;border:1px solid #dbe1ec;border-radius:11px;background:#f7f9fc;font-size:13px;color:#1c2540}\n.control i{color:#8a94aa;font-size:12.5px}\n.control .chev{margin-left:auto;font-size:10px;color:#8a94aa}\n.control.calc{background:#f2f0ff;border-color:#e0dcfb;color:#4338ca;font-weight:700}\n.control.area{height:74px;align-items:flex-start;padding-top:11px;line-height:1.5}\n.checks{list-style:none;margin:0;padding:12px 14px;border-radius:12px;background:#f7f9fc;display:flex;flex-direction:column;gap:7px}\n.checks li{display:flex;align-items:flex-start;gap:8px;font-size:12px;color:#168454;line-height:1.45}\n.checks i{margin-top:2px;font-size:12px}\n.sig-row{display:flex;align-items:center;gap:14px;border:1px solid #e9eef5;border-radius:12px;padding:10px 12px;background:#fbfcfe}\n.sig-preview{flex:0 0 148px;font-family:'Caveat',cursive;font-size:27px;color:#1f3a8a;border-bottom:1px dashed #dbe1ec;padding-bottom:2px}\n.sig-copy b{display:block;font-size:12px;font-weight:700}\n.sig-copy small{display:block;font-size:10.5px;color:#7a849e;margin-top:1px}\n.sig-row .btn{margin-left:auto}\n.btn{display:inline-flex;align-items:center;gap:8px;height:42px;padding:0 16px;border-radius:12px;font:inherit;font-size:13px;font-weight:700;white-space:nowrap}\n.btn.small{height:34px;padding:0 11px;font-size:11.5px;border-radius:9px}\n.btn.ghost{background:#fff;border:1px solid #e3e8f2;color:#465268}\n.btn.primary{background:#5143e8;border:0;color:#fff;box-shadow:0 10px 22px -12px rgba(81,67,232,.8)}\n.checkline{display:flex;align-items:center;gap:8px;margin-top:10px;font-size:12px;color:#465268}\n.checkline input{width:15px;height:15px;accent-color:#5143e8;margin:0}\n.route-note{display:flex;align-items:flex-start;gap:9px;padding:11px 13px;border:1px solid #e9eef5;border-radius:12px;background:#f7f9fc;font-size:12px;line-height:1.5;color:#465268}\n.route-note i{color:#5143e8;margin-top:3px;font-size:12px}\n.route-note b{font-weight:700;color:#283451}\n.m-foot{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 24px;border-top:1px solid #e9eef5;background:#fbfcfe}\n.foot-note{max-width:290px;font-size:11px;line-height:1.45;color:#7a849e}\n.foot-actions{display:flex;gap:8px}\n</style>\n<div class=\"backdrop\" data-kid=\"1\" data-name=\"backdrop container for modal\">\n<section aria-labelledby=\"form-title\" aria-modal=\"true\" class=\"modal\" data-kid=\"1-1\" data-name=\"rejected leave form modal dialog\" role=\"dialog\">\n<header class=\"m-head\" data-kid=\"1-1-1\" data-name=\"modal header with document status\">\n<div data-kid=\"1-1-1-1\" data-name=\"header info block\">\n<div class=\"docline\" data-kid=\"1-1-1-1-1\" data-name=\"document reference line\"><span class=\"no\" data-kid=\"1-1-1-1-1-1\" data-name=\"document reference number\">LV-2026-0012</span><span class=\"sep\" data-kid=\"1-1-1-1-1-2\" data-name=\"reference line separator dot\"></span><span class=\"when\" data-kid=\"1-1-1-1-1-3\" data-name=\"request title summary (hot leave 3 days)\">ลาพักร้อน · 3 วัน</span></div>\n<h2 data-kid=\"1-1-1-1-2\" data-name=\"modal main headline (amend and resubmit)\" id=\"form-title\">แก้ไขเอกสารและยื่นใหม่</h2>\n<div class=\"statusline\" data-kid=\"1-1-1-1-3\" data-name=\"current status line\">\n<span class=\"chip rejected\" data-kid=\"1-1-1-1-3-1\" data-name=\"rejected status chip\">สถานะปัจจุบัน · ไม่อนุมัติ</span>\n<span class=\"meta\" data-kid=\"1-1-1-1-3-2\" data-name=\"submission history meta text\">ยื่นครั้งแรก 10 พ.ย. 69 · ยังไม่ยื่นฉบับแก้ไข</span>\n</div>\n</div>\n<button aria-label=\"ปิด\" class=\"close\" data-kid=\"1-1-1-2\" data-name=\"close modal button\">×</button>\n</header>\n<div class=\"m-body\" data-kid=\"1-1-2\" data-name=\"modal body content\">\n<section class=\"feedback\" data-kid=\"1-1-2-1\" data-name=\"rejection feedback panel\">\n<div class=\"fb-head\" data-kid=\"1-1-2-1-1\" data-name=\"rejection panel header\">\n<i class=\"fa-solid fa-circle-exclamation\" data-kid=\"1-1-2-1-1-1\" data-name=\"exclamation warning icon\"></i>\n<h3 data-kid=\"1-1-2-1-1-2\" data-name=\"rejection reason panel title\">เหตุผลที่ไม่อนุมัติ</h3>\n<span class=\"when\" data-kid=\"1-1-2-1-1-3\" data-name=\"rejection date and time\">11 พ.ย. 69 14:20</span>\n</div>\n<p class=\"fb-reason\" data-kid=\"1-1-2-1-2\" data-name=\"rejection reason paragraph\">วันที่ 18–19 พ.ย. มีประชุมปิดงบการตลาด ขอให้เลื่อนวันลาเป็นสัปดาห์ถัดไป และแจ้งหัวหน้างานอีกครั้งหลังปรับวันแล้ว</p>\n<div class=\"fb-meta\" data-kid=\"1-1-2-1-3\" data-name=\"approver identity row\">\n<img alt=\"วีระ ศรีสุข\" data-kid=\"1-1-2-1-3-1\" data-name=\"approver avatar photo\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/44?u=weera-srisuk\"/>\n<span data-kid=\"1-1-2-1-3-2\" data-name=\"approver name and role text\"><b data-kid=\"1-1-2-1-3-2-1\" data-name=\"approver name\">วีระ ศรีสุข</b> · ผู้จัดการแผนกการตลาด</span>\n</div>\n</section>\n<section data-kid=\"1-1-2-2\" data-name=\"leave document details section\">\n<h3 class=\"section-title\" data-kid=\"1-1-2-2-1\" data-name=\"document details section title\">ข้อมูลใบลา</h3>\n<div class=\"form-grid\" data-kid=\"1-1-2-2-2\" data-name=\"leave details form grid\">\n<label class=\"field\" data-kid=\"1-1-2-2-2-1\" data-name=\"leave type field\">\n<span data-kid=\"1-1-2-2-2-1-1\" data-name=\"leave type field label\">ประเภทการลา</span>\n<div class=\"control\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"leave type select control\">ลาพักร้อน <i class=\"fa-solid fa-chevron-down chev\" data-kid=\"1-1-2-2-2-1-2-1\" data-name=\"dropdown chevron icon\"></i></div>\n</label>\n<label class=\"field\" data-kid=\"1-1-2-2-2-2\" data-name=\"applicant field\">\n<span data-kid=\"1-1-2-2-2-2-1\" data-name=\"applicant field label\">ผู้ยื่น</span>\n<div class=\"control\" data-kid=\"1-1-2-2-2-2-2\" data-name=\"applicant and department control\">สมชาย ใจดี · การตลาด</div>\n</label>\n<label class=\"field\" data-kid=\"1-1-2-2-2-3\" data-name=\"start date field\">\n<span data-kid=\"1-1-2-2-2-3-1\" data-name=\"start date field label\">วันที่เริ่ม</span>\n<div class=\"control\" data-kid=\"1-1-2-2-2-3-2\" data-name=\"start date control\"><i class=\"fa-regular fa-calendar-days\" data-kid=\"1-1-2-2-2-3-2-1\" data-name=\"calendar icon\"></i> 23 พ.ย. 2569</div>\n</label>\n<label class=\"field\" data-kid=\"1-1-2-2-2-4\" data-name=\"end date field\">\n<span data-kid=\"1-1-2-2-2-4-1\" data-name=\"end date field label\">วันที่สิ้นสุด</span>\n<div class=\"control\" data-kid=\"1-1-2-2-2-4-2\" data-name=\"end date control\"><i class=\"fa-regular fa-calendar-days\" data-kid=\"1-1-2-2-2-4-2-1\" data-name=\"calendar icon\"></i> 25 พ.ย. 2569</div>\n</label>\n<label class=\"field\" data-kid=\"1-1-2-2-2-5\" data-name=\"duration field\">\n<span data-kid=\"1-1-2-2-2-5-1\" data-name=\"duration field label\">จำนวนวัน</span>\n<div class=\"control calc\" data-kid=\"1-1-2-2-2-5-2\" data-name=\"calculated duration control\">3 วัน (24 ชั่วโมง)</div>\n</label>\n<label class=\"field\" data-kid=\"1-1-2-2-2-6\" data-name=\"remaining leave quota field\">\n<span data-kid=\"1-1-2-2-2-6-1\" data-name=\"remaining quota field label\">สิทธิ์ลาพักร้อนคงเหลือ</span>\n<div class=\"control\" data-kid=\"1-1-2-2-2-6-2\" data-name=\"remaining quota control\">6 วัน</div>\n</label>\n<label class=\"field full\" data-kid=\"1-1-2-2-2-7\" data-name=\"reason for leave field\">\n<span data-kid=\"1-1-2-2-2-7-1\" data-name=\"reason field label\">เหตุผลการลา</span>\n<div class=\"control area\" data-kid=\"1-1-2-2-2-7-2\" data-name=\"reason text area control\">พักผ่อนปลายปีกับครอบครัว</div>\n</label>\n</div>\n</section>\n<section data-kid=\"1-1-2-3\" data-name=\"eligibility validation section\">\n<h3 class=\"section-title\" data-kid=\"1-1-2-3-1\" data-name=\"eligibility section title\">การตรวจสอบเงื่อนไข</h3>\n<ul class=\"checks\" data-kid=\"1-1-2-3-2\" data-name=\"eligibility check items list\">\n<li data-kid=\"1-1-2-3-2-1\" data-name=\"checklist item - sufficient quota\"><i class=\"fa-solid fa-circle-check\" data-kid=\"1-1-2-3-2-1-1\" data-name=\"checkmark icon\"></i> สิทธิ์วันลาคงเหลือ 6 วัน เพียงพอกับการลา 3 วัน</li>\n<li data-kid=\"1-1-2-3-2-2\" data-name=\"checklist item - no overlap\"><i class=\"fa-solid fa-circle-check\" data-kid=\"1-1-2-3-2-2-1\" data-name=\"checkmark icon\"></i> ไม่ทับซ้อนกับใบลาอื่นในช่วง 23–25 พ.ย. 69</li>\n<li data-kid=\"1-1-2-3-2-3\" data-name=\"checklist item - within policy year\"><i class=\"fa-solid fa-circle-check\" data-kid=\"1-1-2-3-2-3-1\" data-name=\"checkmark icon\"></i> อยู่ในปีนโยบาย 2569 (1 ม.ค. – 31 ธ.ค. 69)</li>\n</ul>\n</section>\n<section data-kid=\"1-1-2-4\" data-name=\"signature section\">\n<h3 class=\"section-title\" data-kid=\"1-1-2-4-1\" data-name=\"signature section title\">ลายเซ็นผู้ยื่น</h3>\n<div class=\"sig-row\" data-kid=\"1-1-2-4-2\" data-name=\"signature preview row\">\n<div class=\"sig-preview\" data-kid=\"1-1-2-4-2-1\" data-name=\"signature preview in cursive\">สมชาย ใจดี</div>\n<div class=\"sig-copy\" data-kid=\"1-1-2-4-2-2\" data-name=\"signature description copy\">\n<b data-kid=\"1-1-2-4-2-2-1\" data-name=\"signature description heading\">ลายเซ็นที่บันทึกไว้</b>\n<small data-kid=\"1-1-2-4-2-2-2\" data-name=\"signature description subtext\">ใช้ลายเซ็นเดิมหรือเปลี่ยนใหม่</small>\n</div>\n<button class=\"btn ghost small\" data-kid=\"1-1-2-4-2-3\" data-name=\"change signature button\">เปลี่ยนลายเซ็น</button>\n</div>\n<label class=\"checkline\" data-kid=\"1-1-2-4-3\" data-name=\"remember signature checkbox row\"><input checked=\"\" data-kid=\"1-1-2-4-3-1\" data-name=\"remember signature checkbox\" type=\"checkbox\"/> จำลายเซ็นนี้ไว้ใช้ครั้งถัดไป</label>\n</section>\n<div class=\"route-note\" data-kid=\"1-1-2-5\" data-name=\"approval route note\">\n<i class=\"fa-solid fa-arrow-left\" data-kid=\"1-1-2-5-1\" data-name=\"left arrow icon\"></i>\n<span data-kid=\"1-1-2-5-2\" data-name=\"route note text\">หลังยื่น เอกสารจะกลับไปรอ <b data-kid=\"1-1-2-5-2-1\" data-name=\"approver name in route note\">วีระ ศรีสุข (ผู้จัดการแผนก)</b> พิจารณา แล้วจึงส่งต่อให้ HR</span>\n</div>\n</div>\n<footer class=\"m-foot\" data-kid=\"1-1-3\" data-name=\"modal footer with actions\">\n<span class=\"foot-note\" data-kid=\"1-1-3-1\" data-name=\"footer status note\">สถานะจะเปลี่ยนเป็น “ยื่นแก้ไขใหม่” เมื่อยื่นสำเร็จ</span>\n<div class=\"foot-actions\" data-kid=\"1-1-3-2\" data-name=\"footer action buttons\">\n<button class=\"btn ghost\" data-kid=\"1-1-3-2-1\" data-name=\"cancel button\">ยกเลิก</button>\n<button class=\"btn primary\" data-kid=\"1-1-3-2-2\" data-name=\"primary resubmit button\"><i class=\"fa-solid fa-pen-nib\" data-kid=\"1-1-3-2-2-1\" data-name=\"pen nib icon\"></i> ยื่นแก้ไขใหม่</button>\n</div>\n</footer>\n</section>\n</div>",
