      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Caveat:wght@600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.3.1/css/all.min.css');\n*{box-sizing:border-box}\nbody{margin:0;font-family:'IBM Plex Sans Thai',sans-serif;color:#1c2540;font-size:14px;background:#101629}\n.backdrop{min-height:1240px;padding:40px 20px;background:rgba(16,22,41,.5);display:flex;justify-content:center;align-items:flex-start}\n.modal{width:680px;background:#fff;border-radius:22px;overflow:hidden;box-shadow:0 24px 70px rgba(16,22,41,.35);display:flex;flex-direction:column}\n.m-head{display:flex;justify-content:space-between;gap:14px;padding:20px 24px 16px;border-bottom:1px solid #e9eef5}\n.docline{display:flex;align-items:center;gap:8px;font-size:12px}\n.docline .no{font-weight:700;color:#5143e8;letter-spacing:.02em}\n.docline .sep{width:3px;height:3px;border-radius:50%;background:#c3cad8}\n.docline .when{color:#7a849e}\n.m-head h2{margin:6px 0 0;font-size:21px;font-weight:800;letter-spacing:-.2px}\n.statusline{display:flex;align-items:center;gap:8px;margin-top:9px;flex-wrap:wrap}\n.statusline .meta{font-size:11.5px;color:#7a849e}\n.chip{display:inline-flex;align-items:center;gap:5px;height:24px;padding:0 9px;border-radius:999px;font-size:11.5px;font-weight:700;white-space:nowrap}\n.chip.revised{background:#ece9ff;color:#4c3fd6}\n.chip i{font-size:9.5px}\n.rev-badge{display:inline-flex;align-items:center;gap:5px;height:22px;padding:0 8px;border:1px solid #e0dcfb;border-radius:6px;background:#f6f4ff;color:#5b4fe0;font-size:10.5px;font-weight:700}\n.rev-badge i{font-size:9px}\n.close{flex:none;width:36px;height:36px;border-radius:11px;border:1px solid #e3e8f2;background:#fff;color:#59657a;font-size:17px;line-height:1;display:grid;place-items:center}\n.m-body{padding:20px 24px 24px;display:flex;flex-direction:column;gap:22px}\n.round-now{background:#f6f4ff;border:1px solid #e3dfff;border-radius:14px;padding:14px 16px}\n.round-now .label{font-size:11px;font-weight:700;color:#5b4fe0;margin-bottom:10px}\n.now-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}\n.now-grid small{display:block;font-size:10.5px;color:#7a7fa8;margin-bottom:2px}\n.now-grid strong{display:block;font-size:12.5px;font-weight:700;color:#2b2a52}\n.feedback{background:#fff7f7;border:1px solid #fadadd;border-radius:14px;padding:14px 16px}\n.fb-head{display:flex;align-items:center;gap:8px;margin-bottom:8px}\n.fb-head i{color:#c0392b;font-size:13px}\n.fb-head h3{margin:0;font-size:13px;font-weight:800;color:#9e3b3b}\n.fb-head .when{margin-left:auto;font-size:11px;color:#a86868}\n.fb-reason{margin:0;font-size:13px;line-height:1.6;color:#7d2f2f}\n.fb-meta{display:flex;align-items:center;gap:7px;margin-top:10px;font-size:11.5px;color:#9a6565}\n.fb-meta img{width:22px;height:22px;border-radius:50%;object-fit:cover}\n.fb-meta b{font-weight:700;color:#7d2f2f}\n.section-title{display:flex;align-items:center;gap:8px;margin:0 0 10px;font-size:13.5px;font-weight:800;color:#172033}\n.count-pill{font-size:11px;font-weight:700;color:#5b647a;background:#f2f5f9;border-radius:999px;padding:2px 8px}\n.compare{width:100%;border-collapse:collapse;font-size:12.5px}\n.compare th{text-align:left;font-size:11px;color:#7a849e;font-weight:700;padding:0 10px 8px 0;border-bottom:1px solid #eef2f7}\n.compare td{padding:10px 10px 10px 0;border-bottom:1px solid #f0f3f8;color:#465268}\n.compare td:first-child{color:#7a849e;width:126px}\n.compare td.new{color:#4338ca;font-weight:700}\n.compare tr:last-child td{border-bottom:0}\n.round-group + .round-group{margin-top:14px;padding-top:14px;border-top:1px dashed #e5e9f0}\n.group-head{display:flex;align-items:center;gap:10px;margin-bottom:10px}\n.group-head b{font-size:12px;font-weight:700;color:#283451}\n.group-head span{font-size:11px;color:#7a849e}\n.route{list-style:none;margin:0;padding:0}\n.route li{position:relative;padding:0 0 14px 36px;min-height:30px}\n.route li:last-child{padding-bottom:0}\n.route li::before{content:'';position:absolute;left:11px;top:23px;bottom:0;width:1px;background:#e5e9f0}\n.route li:last-child::before{display:none}\n.node{position:absolute;left:0;top:0;width:23px;height:23px;border-radius:50%;display:grid;place-items:center;font-size:10px;font-weight:800;background:#eef1f6;color:#7a849e}\n.route li.done .node{background:#dcfce7;color:#15803d}\n.route li.rejected .node{background:#fee2e2;color:#b91c1c}\n.route li.current .node{background:#dbeafe;color:#1d4ed8;box-shadow:0 0 0 4px #eff6ff}\n.route b{display:block;font-size:12.5px}\n.route small{display:block;margin-top:1px;font-size:11.5px;color:#7a849e}\n.route em{display:block;font-style:normal;margin-top:5px;padding:6px 9px;border-radius:8px;background:#fff7f7;color:#9e3b3b;font-size:11.5px;line-height:1.5}\n.signatures{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n.sig-card{border:1px solid #e9eef5;border-radius:12px;padding:10px 12px;background:#fbfcfe}\n.sig-img{height:38px;display:flex;align-items:center;font-family:'Caveat',cursive;font-size:26px;color:#1f3a8a}\n.sig-card.empty .sig-img{font-family:'IBM Plex Sans Thai',sans-serif;font-size:11.5px;color:#a1a9b9}\n.sig-card b{display:block;margin-top:3px;font-size:11.5px}\n.sig-card small{display:block;font-size:10.5px;color:#7a849e;margin-top:1px}\n.m-foot{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 24px;border-top:1px solid #e9eef5;background:#fbfcfe}\n.foot-note{max-width:360px;font-size:11px;line-height:1.45;color:#7a849e}\n.btn{display:inline-flex;align-items:center;gap:8px;height:42px;padding:0 18px;border-radius:12px;font:inherit;font-size:13px;font-weight:700}\n.btn.ghost{background:#fff;border:1px solid #e3e8f2;color:#465268}\n</style>\n<div class=\"backdrop\" data-kid=\"1\" data-name=\"page backdrop container\">\n<section aria-labelledby=\"doc-title\" aria-modal=\"true\" class=\"modal\" data-kid=\"1-1\" data-name=\"leave request detail modal\" role=\"dialog\">\n<header class=\"m-head\" data-kid=\"1-1-1\" data-name=\"modal header with document meta\">\n<div data-kid=\"1-1-1-1\" data-name=\"document header info wrapper\">\n<div class=\"docline\" data-kid=\"1-1-1-1-1\" data-name=\"document ID and submission date line\"><span class=\"no\" data-kid=\"1-1-1-1-1-1\" data-name=\"document reference number\">LV-2026-0012</span><span class=\"sep\" data-kid=\"1-1-1-1-1-2\" data-name=\"decorative dot separator\"></span><span class=\"when\" data-kid=\"1-1-1-1-1-3\" data-name=\"submission timestamp text\">ยื่นเมื่อ 10 พ.ย. 69 10:42</span></div>\n<h2 data-kid=\"1-1-1-1-2\" data-name=\"leave request title heading\" id=\"doc-title\">ลาพักร้อน · 3 วัน</h2>\n<div class=\"statusline\" data-kid=\"1-1-1-1-3\" data-name=\"status chip and status line\">\n<span class=\"chip revised\" data-kid=\"1-1-1-1-3-1\" data-name=\"re-submission status chip\"><i class=\"fa-solid fa-pen-nib\" data-kid=\"1-1-1-1-3-1-1\" data-name=\"pen nib icon\"></i> ยื่นแก้ไขใหม่</span>\n<span class=\"rev-badge\" data-kid=\"1-1-1-1-3-2\" data-name=\"revision count badge\"><i class=\"fa-solid fa-pen-nib\" data-kid=\"1-1-1-1-3-2-1\" data-name=\"pen nib icon\"></i> แก้ไขครั้งที่ 1</span>\n<span class=\"meta\" data-kid=\"1-1-1-1-3-3\" data-name=\"pending reviewer status text\">รอผู้จัดการแผนก · วีระ ศรีสุข</span>\n</div>\n</div>\n<button aria-label=\"ปิด\" class=\"close\" data-kid=\"1-1-1-2\" data-name=\"close modal button\">×</button>\n</header>\n<div class=\"m-body\" data-kid=\"1-1-2\" data-name=\"modal body content area\">\n<section class=\"round-now\" data-kid=\"1-1-2-1\" data-name=\"current approval round summary card\">\n<div class=\"label\" data-kid=\"1-1-2-1-1\" data-name=\"current round header label\">รอบที่ 2 · ยื่นฉบับแก้ไข 14 พ.ย. 69 09:15</div>\n<div class=\"now-grid\" data-kid=\"1-1-2-1-2\" data-name=\"current round details grid\">\n<div data-kid=\"1-1-2-1-2-1\" data-name=\"current step detail cell\"><small data-kid=\"1-1-2-1-2-1-1\" data-name=\"current step small label\">ขั้นปัจจุบัน</small><strong data-kid=\"1-1-2-1-2-1-2\" data-name=\"current step value\">ผู้จัดการแผนก</strong></div>\n<div data-kid=\"1-1-2-1-2-2\" data-name=\"reviewer detail cell\"><small data-kid=\"1-1-2-1-2-2-1\" data-name=\"reviewer small label\">ผู้พิจารณา</small><strong data-kid=\"1-1-2-1-2-2-2\" data-name=\"reviewer name value\">วีระ ศรีสุข</strong></div>\n<div data-kid=\"1-1-2-1-2-3\" data-name=\"next step detail cell\"><small data-kid=\"1-1-2-1-2-3-1\" data-name=\"next step small label\">ขั้นถัดไป</small><strong data-kid=\"1-1-2-1-2-3-2\" data-name=\"next step value\">HR</strong></div>\n</div>\n</section>\n<section class=\"feedback\" data-kid=\"1-1-2-2\" data-name=\"previous rejection feedback card\">\n<div class=\"fb-head\" data-kid=\"1-1-2-2-1\" data-name=\"feedback card header\">\n<i class=\"fa-solid fa-circle-exclamation\" data-kid=\"1-1-2-2-1-1\" data-name=\"exclamation warning icon\"></i>\n<h3 data-kid=\"1-1-2-2-1-2\" data-name=\"rejection reason heading\">เหตุผลที่ไม่อนุมัติครั้งก่อน</h3>\n<span class=\"when\" data-kid=\"1-1-2-2-1-3\" data-name=\"rejection timestamp text\">11 พ.ย. 69 14:20</span>\n</div>\n<p class=\"fb-reason\" data-kid=\"1-1-2-2-2\" data-name=\"rejection explanation text\">วันที่ 18–19 พ.ย. มีประชุมปิดงบการตลาด ขอให้เลื่อนวันลาเป็นสัปดาห์ถัดไป และแจ้งหัวหน้างานอีกครั้งหลังปรับวันแล้ว</p>\n<div class=\"fb-meta\" data-kid=\"1-1-2-2-3\" data-name=\"feedback author metadata row\">\n<img alt=\"วีระ ศรีสุข\" data-kid=\"1-1-2-2-3-1\" data-name=\"reviewer profile avatar false\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/44?u=weera-srisuk\"/>\n<span data-kid=\"1-1-2-2-3-2\"><b data-kid=\"1-1-2-2-3-2-1\">วีระ ศรีสุข</b> · ผู้จัดการแผนกการตลาด</span>\n</div>\n</section>\n<section data-kid=\"1-1-2-3\">\n<h3 class=\"section-title\" data-kid=\"1-1-2-3-1\">รายการที่แก้ไข</h3>\n<table class=\"compare\" data-kid=\"1-1-2-3-2\">\n<thead data-kid=\"1-1-2-3-2-1\">\n<tr data-kid=\"1-1-2-3-2-1-1\"><th data-kid=\"1-1-2-3-2-1-1-1\">รายการ</th><th data-kid=\"1-1-2-3-2-1-1-2\">ก่อนแก้ไข</th><th data-kid=\"1-1-2-3-2-1-1-3\">หลังแก้ไข</th></tr>\n</thead>\n<tbody data-kid=\"1-1-2-3-2-2\">\n<tr data-kid=\"1-1-2-3-2-2-1\"><td data-kid=\"1-1-2-3-2-2-1-1\">วันที่เริ่ม</td><td data-kid=\"1-1-2-3-2-2-1-2\">18 พ.ย. 69</td><td class=\"new\" data-kid=\"1-1-2-3-2-2-1-3\">23 พ.ย. 69</td></tr>\n<tr data-kid=\"1-1-2-3-2-2-2\"><td data-kid=\"1-1-2-3-2-2-2-1\">วันที่สิ้นสุด</td><td data-kid=\"1-1-2-3-2-2-2-2\">20 พ.ย. 69</td><td class=\"new\" data-kid=\"1-1-2-3-2-2-2-3\">25 พ.ย. 69</td></tr>\n</tbody>\n</table>\n</section>\n<section data-kid=\"1-1-2-4\">\n<h3 class=\"section-title\" data-kid=\"1-1-2-4-1\">ขั้นตอนการพิจารณา</h3>\n<div class=\"round-group\" data-kid=\"1-1-2-4-2\">\n<div class=\"group-head\" data-kid=\"1-1-2-4-2-1\"><b data-kid=\"1-1-2-4-2-1-1\">รอบที่ 1</b><span data-kid=\"1-1-2-4-2-1-2\">10–11 พ.ย. 69</span></div>\n<ol class=\"route\" data-kid=\"1-1-2-4-2-2\">\n<li class=\"done\" data-kid=\"1-1-2-4-2-2-1\">\n<span class=\"node\" data-kid=\"1-1-2-4-2-2-1-1\"><i class=\"fa-solid fa-check\" data-kid=\"1-1-2-4-2-2-1-1-1\"></i></span>\n<div data-kid=\"1-1-2-4-2-2-1-2\"><b data-kid=\"1-1-2-4-2-2-1-2-1\">ผู้ยื่น</b><small data-kid=\"1-1-2-4-2-2-1-2-2\">สมชาย ใจดี · ยื่นเมื่อ 10 พ.ย. 69 10:42</small></div>\n</li>\n<li class=\"rejected\" data-kid=\"1-1-2-4-2-2-2\">\n<span class=\"node\" data-kid=\"1-1-2-4-2-2-2-1\">!</span>\n<div data-kid=\"1-1-2-4-2-2-2-2\">\n<b data-kid=\"1-1-2-4-2-2-2-2-1\">ผู้จัดการแผนก</b>\n<small data-kid=\"1-1-2-4-2-2-2-2-2\">วีระ ศรีสุข · ไม่อนุมัติ 11 พ.ย. 69 14:20</small>\n<em data-kid=\"1-1-2-4-2-2-2-2-3\">เหตุผล: วันที่ 18–19 พ.ย. มีประชุมปิดงบการตลาด ขอให้เลื่อนวันลาเป็นสัปดาห์ถัดไป</em>\n</div>\n</li>\n</ol>\n</div>\n<div class=\"round-group\" data-kid=\"1-1-2-4-3\">\n<div class=\"group-head\" data-kid=\"1-1-2-4-3-1\"><b data-kid=\"1-1-2-4-3-1-1\">รอบที่ 2</b><span data-kid=\"1-1-2-4-3-1-2\">เริ่มพิจารณาใหม่ที่ขั้นผู้จัดการแผนก 14 พ.ย. 69</span></div>\n<ol class=\"route\" data-kid=\"1-1-2-4-3-2\">\n<li class=\"current\" data-kid=\"1-1-2-4-3-2-1\">\n<span class=\"node\" data-kid=\"1-1-2-4-3-2-1-1\"><i class=\"fa-solid fa-clock\" data-kid=\"1-1-2-4-3-2-1-1-1\"></i></span>\n<div data-kid=\"1-1-2-4-3-2-1-2\"><b data-kid=\"1-1-2-4-3-2-1-2-1\">ผู้จัดการแผนก</b><small data-kid=\"1-1-2-4-3-2-1-2-2\">รอพิจารณา · วีระ ศรีสุข · ตั้งแต่ 14 พ.ย. 69</small></div>\n</li>\n<li data-kid=\"1-1-2-4-3-2-2\">\n<span class=\"node\" data-kid=\"1-1-2-4-3-2-2-1\"></span>\n<div data-kid=\"1-1-2-4-3-2-2-2\"><b data-kid=\"1-1-2-4-3-2-2-2-1\">HR</b><small data-kid=\"1-1-2-4-3-2-2-2-2\">รอดำเนินการ</small></div>\n</li>\n</ol>\n</div>\n</section>\n<section data-kid=\"1-1-2-5\">\n<h3 class=\"section-title\" data-kid=\"1-1-2-5-1\">ลายเซ็น</h3>\n<div class=\"signatures\" data-kid=\"1-1-2-5-2\">\n<div class=\"sig-card\" data-kid=\"1-1-2-5-2-1\">\n<div class=\"sig-img\" data-kid=\"1-1-2-5-2-1-1\">สมชาย ใจดี</div>\n<b data-kid=\"1-1-2-5-2-1-2\">ผู้ยื่น</b>\n<small data-kid=\"1-1-2-5-2-1-3\">10 พ.ย. 69</small>\n</div>\n<div class=\"sig-card empty\" data-kid=\"1-1-2-5-2-2\">\n<div class=\"sig-img\" data-kid=\"1-1-2-5-2-2-1\">ยังไม่มีลายเซ็น</div>\n<b data-kid=\"1-1-2-5-2-2-2\">ผู้จัดการแผนก</b>\n<small data-kid=\"1-1-2-5-2-2-3\">รอพิจารณา</small>\n</div>\n</div>\n</section>\n</div>\n<footer class=\"m-foot\" data-kid=\"1-1-3\">\n<span class=\"foot-note\" data-kid=\"1-1-3-1\">เลขที่เอกสาร LV-2026-0012 · ประวัติการพิจารณารอบที่ 1 เก็บไว้ครบถ้วน</span>\n<button class=\"btn ghost\" data-kid=\"1-1-3-2\">ปิด</button>\n</footer>\n</section>\n</div>",
