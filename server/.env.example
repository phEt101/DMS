NODE_ENV=development
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=3000
# จำนวน hop ของ reverse proxy ที่เชื่อถือได้ (Apache/Cloudflare = 1)
TRUST_PROXY=0

# จำกัดเฉพาะการล็อกอินที่ผิด (ไม่นับครั้งที่สำเร็จ) — ต้องรับคนเข้าพร้อมกันได้
LOGIN_RATE_LIMIT_MAX_FAILURES=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=boswell_dms
DB_USER=shared_app
DB_PASSWORD=change_this_shared_password
DB_CONNECTION_LIMIT=10

# Required only when running db:seed. Use a temporary value and rotate it after first login.
SEED_DEFAULT_PASSWORD=

# Generate once and keep permanently. Changing it will affect newly generated document public IDs.
PROJECT_PUBLIC_ID_SECRET=replace_with_at_least_32_random_characters
